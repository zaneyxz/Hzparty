rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'juliotobzin378@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 2 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTicketCode(code) {
      return code is string &&
        code.size() == 9 &&
        code.matches('^HZ-[A-Z0-9]{6}$');
    }

    function isValidEventEdition(data) {
      return data.keys().hasAll([
          'id', 'title', 'subtitle', 'dateLabel', 'timeRange',
          'venue', 'city', 'status', 'capacityLabel', 'ageRating',
          'dressCode', 'lineupHighlights', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'subtitle', 'dateLabel', 'timeRange',
          'venue', 'city', 'status', 'capacityLabel', 'ageRating',
          'dressCode', 'lineupHighlights', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() >= 3 && data.subtitle.size() <= 400 &&
        data.dateLabel is string && data.dateLabel.size() >= 3 && data.dateLabel.size() <= 80 &&
        data.timeRange is string && data.timeRange.size() >= 3 && data.timeRange.size() <= 40 &&
        data.venue is string && data.venue.size() >= 2 && data.venue.size() <= 120 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.status in ['proximo', 'em-breve', 'rascunho'] &&
        data.capacityLabel is string && data.capacityLabel.size() >= 1 && data.capacityLabel.size() <= 80 &&
        data.ageRating is string && data.ageRating.size() >= 1 && data.ageRating.size() <= 100 &&
        data.dressCode is string && data.dressCode.size() >= 1 && data.dressCode.size() <= 80 &&
        data.lineupHighlights is list &&
        data.lineupHighlights.size() >= 1 &&
        data.lineupHighlights.size() <= 10 &&
        data.lineupHighlights[0] is string &&
        data.updatedAt is timestamp;
    }

    function isValidGuestListEntry(data) {
      return data.keys().hasAll([
          'protocol', 'fullName', 'whatsapp', 'eventTitle', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'protocol', 'fullName', 'whatsapp', 'eventTitle', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.protocol is string && data.protocol.size() == 11 && data.protocol.matches('^HZPL-[A-Z0-9]{6}$') &&
        data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120 &&
        data.whatsapp is string && data.whatsapp.size() >= 10 && data.whatsapp.size() <= 20 &&
        data.eventTitle is string && data.eventTitle.size() >= 3 && data.eventTitle.size() <= 120 &&
        data.status in ['aguardando', 'confirmado'] &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidGuestListPublicEntry(data) {
      return data.keys().hasAll([
          'protocol', 'fullName', 'eventTitle', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'protocol', 'fullName', 'eventTitle', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.protocol is string && data.protocol.size() == 11 && data.protocol.matches('^HZPL-[A-Z0-9]{6}$') &&
        data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120 &&
        data.eventTitle is string && data.eventTitle.size() >= 3 && data.eventTitle.size() <= 120 &&
        data.status in ['aguardando', 'confirmado'] &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidTicketPass(data) {
      return data.keys().hasAll([
          'ticketCode', 'displayName', 'eventTitle', 'eventDate', 'eventTime',
          'venue', 'tierName', 'quantity', 'totalCents', 'mpPaymentId', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ticketCode', 'displayName', 'eventTitle', 'eventDate', 'eventTime',
          'venue', 'tierName', 'quantity', 'totalCents', 'mpPaymentId', 'status',
          'createdAt', 'updatedAt', 'validatedAtLabel'
        ]) &&
        isValidTicketCode(data.ticketCode) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.eventTitle is string && data.eventTitle.size() >= 3 && data.eventTitle.size() <= 120 &&
        data.eventDate is string && data.eventDate.size() >= 3 && data.eventDate.size() <= 80 &&
        data.eventTime is string && data.eventTime.size() >= 3 && data.eventTime.size() <= 40 &&
        data.venue is string && data.venue.size() >= 2 && data.venue.size() <= 120 &&
        data.tierName is string && data.tierName.size() >= 2 && data.tierName.size() <= 160 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 12 &&
        data.totalCents is int && data.totalCents >= 1500 && data.totalCents <= 500000 &&
        data.mpPaymentId is string && data.mpPaymentId.size() >= 1 && data.mpPaymentId.size() <= 64 &&
        data.status in ['aguardando-pagamento', 'pago', 'validado'] &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        (!('validatedAtLabel' in data) || (data.validatedAtLabel is string && data.validatedAtLabel.size() <= 40));
    }

    function isValidTicketContact(data) {
      return data.keys().hasAll(['ticketCode', 'holderName', 'whatsapp', 'createdAt']) &&
        data.keys().hasOnly(['ticketCode', 'holderName', 'whatsapp', 'createdAt']) &&
        isValidTicketCode(data.ticketCode) &&
        data.holderName is string && data.holderName.size() >= 3 && data.holderName.size() <= 120 &&
        data.whatsapp is string && data.whatsapp.size() >= 10 && data.whatsapp.size() <= 20 &&
        data.createdAt is timestamp;
    }

    // 1. Public Events Catalog (Admin-managed)
    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(eventId) &&
        isValidEventEdition(incoming()) &&
        incoming().id == eventId &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(eventId) &&
        isValidEventEdition(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'dateLabel', 'timeRange', 'venue', 'city',
          'status', 'capacityLabel', 'ageRating', 'dressCode', 'lineupHighlights', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(eventId);
    }

    // 2. Guest List (PII isolated to Admin; visitors create atomically with public projection)
    match /guest_list/{entryId} {
      allow create: if isValidId(entryId) &&
        isValidGuestListEntry(incoming()) &&
        incoming().status == 'aguardando' &&
        incoming().createdAt == request.time &&
        !('updatedAt' in incoming()) &&
        existsAfter(/databases/$(database)/documents/guest_list_public/$(entryId));
      allow get: if isAdmin() && isValidId(entryId);
      allow list: if isAdmin();
      allow update: if isAdmin() &&
        isValidId(entryId) &&
        isValidGuestListEntry(incoming()) &&
        incoming().protocol == existing().protocol &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(entryId);
    }

    // 2b. Public Guest List Display (Zero PII — name, protocol, eventTitle, status only)
    match /guest_list_public/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if isValidId(entryId) &&
        isValidGuestListPublicEntry(incoming()) &&
        incoming().status == 'aguardando' &&
        incoming().createdAt == request.time &&
        !('updatedAt' in incoming()) &&
        existsAfter(/databases/$(database)/documents/guest_list/$(entryId));
      allow update: if isAdmin() &&
        isValidId(entryId) &&
        isValidGuestListPublicEntry(incoming()) &&
        incoming().protocol == existing().protocol &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(entryId);
    }

    // 3. Digital Ticket Passes (Public single-doc lookup by exact code only; no list scraping)
    match /tickets/{ticketId} {
      allow get: if isAdmin() || isValidTicketCode(ticketId);
      allow list: if isAdmin();
      allow create: if isValidTicketCode(ticketId) &&
        isValidTicketPass(incoming()) &&
        incoming().ticketCode == ticketId &&
        incoming().status == 'aguardando-pagamento' &&
        incoming().createdAt == request.time &&
        !('updatedAt' in incoming()) &&
        !('validatedAtLabel' in incoming()) &&
        existsAfter(/databases/$(database)/documents/ticket_contacts/$(ticketId));
      allow update: if isAdmin() &&
        isValidTicketCode(ticketId) &&
        isValidTicketPass(incoming()) &&
        incoming().ticketCode == existing().ticketCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'validatedAtLabel']);
      allow delete: if isAdmin() && isValidTicketCode(ticketId);
    }

    // 4. Isolated Buyer PII Contacts (Admin read-only)
    match /ticket_contacts/{ticketId} {
      allow create: if isValidTicketCode(ticketId) &&
        isValidTicketContact(incoming()) &&
        incoming().ticketCode == ticketId &&
        incoming().createdAt == request.time;
      allow get, delete: if isAdmin() && isValidTicketCode(ticketId);
      allow list: if isAdmin();
    }

    // 5. Admin Registry (Managed out-of-band; never writable by clients)
    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
